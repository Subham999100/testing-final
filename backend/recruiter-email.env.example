# Append these to backend/.env using values supplied by your email administrator.
# Keep the existing DATABASE_URL, auth secrets and other variables.
RECRUITER_SMTP_HOST=
RECRUITER_SMTP_PORT=587
RECRUITER_SMTP_SECURE=false
RECRUITER_SMTP_USER=
RECRUITER_SMTP_PASSWORD=
RECRUITER_EMAIL_FROM=
RECRUITER_EMAIL_REPLY_TO=
# Port 465 usually requires RECRUITER_SMTP_SECURE=true.
# TLS certificate validation remains enabled. Use a verified sender address.
